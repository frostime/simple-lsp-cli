{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/frostime/simple-lsp-cli/main/schema/slsp.schema.json",
  "title": "simple-lsp-cli configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "enum": ["1.0", "2.0"]
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/language"
      }
    },
    "servers": {
      "type": "object"
    },
    "defaults": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[^.].*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "1.0" }
        }
      },
      "then": {
        "properties": {
          "servers": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/serverV1" }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": { "const": "2.0" }
        }
      },
      "then": {
        "properties": {
          "servers": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/serverV2" }
          }
        },
        "not": {
          "required": ["defaults"]
        }
      }
    }
  ],
  "$defs": {
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extensions", "languageId", "servers"],
      "properties": {
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^.].*$"
          }
        },
        "languageId": {
          "type": "string",
          "minLength": 1
        },
        "servers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serverV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "transport": {
          "const": "stdio",
          "default": "stdio"
        },
        "rootMarkers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initializationOptions": {
          "type": "object"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "serverV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "extensions", "languageIds"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "transport": {
          "const": "stdio",
          "default": "stdio"
        },
        "extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^.].*$"
          }
        },
        "languageIds": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "rootMarkers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "initializationOptions": {
          "type": "object"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
